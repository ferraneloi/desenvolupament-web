---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Pàgina no trobada | Desenvolupament Web" description="Aquesta pàgina no existeix.">
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3 font-heading text-3xl font-semibold">Aquesta pàgina no existeix</h1>
    <p class="mt-3 text-foreground/70">
      Potser l'enllaç és antic o hi ha una errada. Torna a l'índex per triar un curs.
    </p>
    <a
      href="/"
      class="mt-6 inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground hover:bg-primary/90"
    >
      Torna als cursos
    </a>
  </div>
</MainLayout>

