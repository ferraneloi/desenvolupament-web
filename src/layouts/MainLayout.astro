---
import '../styles/global.css';
import SiteHeader from '../components/site/SiteHeader';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Desenvolupament Web — Tutorials i projectes en català",
  description = "Plataforma educativa per aprendre desenvolupament web en català: HTML, CSS, JavaScript i Projectes Pràctics.",
  image = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://desenvolupament-web.vercel.app');
---

<!doctype html>
<html lang="ca" class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Theme init (avoid flash) -->
    <script is:inline>
      (function () {
        const theme = localStorage.getItem('aula-theme') || 'light';
        if (theme === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body data-react-root>
    <SiteHeader client:load />
    <main>
      <slot />
    </main>
    <footer class="mt-16 border-t border-border py-8 text-center text-sm text-muted-foreground flex flex-col items-center gap-1.5">
      <div>Made with Astro and ❤️</div>
      <div class="text-[0.72rem] text-muted-foreground flex items-center gap-1.5">
        <span>by <strong class="text-foreground font-semibold">Ferran Eloi</strong></span>
        <span>·</span>
        <span class="truncate">Institut Caparrella</span>
      </div>
    </footer>
  </body>
</html>

